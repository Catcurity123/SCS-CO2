{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": "s3:ListBucket",
        "Resource": [
            "${aws_s3_bucket_arn}/*",
            "${aws_s3_bucket_arn}"
        ]
      },
      {
        "Effect": "Allow",
        "Action": [
          "s3:GetObject",
          "s3:PutObject"
        ],
        "Resource": [
            "${aws_s3_bucket_arn}/*",
            "${aws_s3_bucket_arn}"
        ]
      }
    ]
  }
  