{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "s3ListPolicy",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:ListAllMyBuckets"
            ],
            "Resource": [
                "${aws_s3_bucket_arn}",
                "${aws_s3_bucket_arn}/*"
            ]
        }
    ]
}
